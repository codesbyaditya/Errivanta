# =============================================================
# ServiceWatch SaaS — Environment Configuration Template
# =============================================================

# -------------------------------------------------------------
# Core Infrastructure
# -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=servicewatch_monitoring
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/servicewatch_monitoring
REDIS_URL=redis://localhost:6379/0

# -------------------------------------------------------------
# Security & JWT Authentication
# -------------------------------------------------------------
JWT_SECRET=servicewatch_super_secure_production_secret_key_2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -------------------------------------------------------------
# Alerting & Notifications (Email & Slack)
# -------------------------------------------------------------
NOTIFICATIONS_ENABLED=true
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK_URL
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=alerts@servicewatch.io
ALERT_EMAIL_RECIPIENT=devops-alerts@company.com

# -------------------------------------------------------------
# Monitored Microservices Ports & Telemetry Keys
# -------------------------------------------------------------
PAYMENT_SERVICE_PORT=8000
PAYMENT_SERVICE_API_KEY=sw_demo_payment_key_12345

ORDER_SERVICE_PORT=8002
ORDER_SERVICE_API_KEY=sw_demo_order_key_12345

USER_SERVICE_PORT=8003
USER_SERVICE_API_KEY=sw_live_user_service_key

SERVICEWATCH_URL=http://localhost:8001/api/v1/telemetry
